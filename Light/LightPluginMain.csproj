<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light</AssemblyName>
        <RootNamespace>Light</RootNamespace>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Light In The Dark - Among Us Mod</Description>

        <!-- 游戏目录：仅用于自动复制，优先使用环境变量 LIGHT_AMONGUS -->
        <AmongUs Condition="'$(LIGHT_AMONGUS)' != ''">$(LIGHT_AMONGUS)</AmongUs>
        <AmongUs Condition="'$(LIGHT_AMONGUS)' == ''">F:\AU\暗中辉0.0.0.1</AmongUs>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LightAPI\LightInDark.csproj" />
    </ItemGroup>

    <!-- 从 Libs 目录引用所有依赖程序集 -->
    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_LibDlls Include="..\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
            <Reference Include="@(_LibDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <!-- 编译完成后自动复制到游戏插件目录 -->
    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />
        <Copy SourceFiles="$(OutDir)LightInDark.dll" DestinationFolder="$(AmongUs)/BepInEx/plugins/" Condition="Exists('$(OutDir)LightInDark.dll')" />
    </Target>
</Project>