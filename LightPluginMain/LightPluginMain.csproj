<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <AssemblyName>Light</AssemblyName>
        <RootNamespace>Light</RootNamespace>

        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>dev</VersionSuffix>
        <Description>Light In The Dark - Among Us Mod</Description>

        <AmongUs>F:\AU\暗中辉0.0.0.1</AmongUs>
        <GameInteropDir>$(AmongUs)\BepInEx\interop</GameInteropDir>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*.*" />
    </ItemGroup>

    <!-- 从游戏目录引用必要的程序集 -->
    <Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <!-- 游戏 interop 程序集 -->
            <_InteropDlls Include="$(GameInteropDir)\*.dll" Exclude="$(GameInteropDir)\netstandard.dll" />
            <Reference Include="@(_InteropDlls->'%(FileName)')">
                <HintPath>%(FullPath)</HintPath>
                <Private>false</Private>
            </Reference>

            <!-- Reactor 2.5.1 -->
            <Reference Include="Reactor">
                <HintPath>$(AmongUs)\BepInEx\plugins\Reactor.dll</HintPath>
                <Private>false</Private>
            </Reference>

            <!-- BepInEx 核心运行时（仅托管程序集） -->
            <Reference Include="BepInEx.Core">
                <HintPath>$(AmongUs)\BepInEx\core\BepInEx.Core.dll</HintPath>
                <Private>false</Private>
            </Reference>
            <Reference Include="BepInEx.Unity.IL2CPP">
                <HintPath>$(AmongUs)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
                <Private>false</Private>
            </Reference>
            <Reference Include="0Harmony">
                <HintPath>$(AmongUs)\BepInEx\core\0Harmony.dll</HintPath>
                <Private>false</Private>
            </Reference>
            <Reference Include="Il2CppInterop.Runtime">
                <HintPath>$(AmongUs)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
                <Private>false</Private>
            </Reference>
            <Reference Include="Il2CppInterop.HarmonySupport">
                <HintPath>$(AmongUs)\BepInEx\core\Il2CppInterop.HarmonySupport.dll</HintPath>
                <Private>false</Private>
            </Reference>
        </ItemGroup>
    </Target>

    <!-- 编译完成后自动复制到游戏插件目录 -->
    <Target Name="Copy" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />
    </Target>
</Project>
