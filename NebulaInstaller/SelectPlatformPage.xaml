<Page x:Class="NebulaInstaller.SelectPlatformPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NebulaInstaller"
      mc:Ignorable="d"
      d:DesignHeight="320" d:DesignWidth="620"
      Title="SelectPlatformPage">

    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="20,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" ><Run Language="ja-jp" Text="このAmong Usのプラットフォームを選択してください。"/></TextBlock>
        <RadioButton x:Name="SteamRadioButton" Content="Steam版" GroupName="Platform" Margin="40,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <RadioButton x:Name="EpicRadioButton" Content="Epic Games版" GroupName="Platform" Margin="40,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="次へ" Margin="0,0,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="80" Click="ClickNext"/>
        <Button Content="戻る" Margin="0,0,110,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="80"  Click="ClickPrev"/>

    </Grid>
</Page>
